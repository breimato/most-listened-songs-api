[Unit]
Description=Publica en SiteGround la URL del tunel de Youtube
Wants=youtube-quick-tunnel.service
After=youtube-quick-tunnel.service
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/python3 __SCRIPT__
Restart=always
RestartSec=10
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=default.target
