# Copia a .env.deploy.local y rellena (no commitear)
FTP_HOST=ftp.breimato.es
FTP_USER=usuario@breimato.es
FTP_PASSWORD=
FTP_PORT=21
FTP_REMOTE_DIR=breimato.es/public_html/youtube
FTP_SECURE=false

VITE_BASE_PATH=/youtube/
# URL pública HTTPS del backend (túnel Cloudflare hacia el cluster)
VITE_API_URL=
