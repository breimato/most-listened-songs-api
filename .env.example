# Base de datos
# Opción A (Docker/Kubernetes): dejar DATABASE_URL vacío y definir DB_HOST=postgres
# Opción B (local): DATABASE_URL=sqlite:///canciones.db
DATABASE_URL=sqlite:///canciones.db
DB_HOST=
DB_PORT=5432
DB_NAME=canciones_db
DB_USERNAME=canciones_user
DB_PASSWORD=canciones_pass

# Last.fm
LASTFM_API_KEY=
LASTFM_USERNAME=

# Llave de acceso (protege la API). Vacía = sin autenticación solo en local.
ACCESS_KEY=

# CORS (orígenes separados por comas)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://breimato.es,https://www.breimato.es
